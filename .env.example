# Copie para .env.local. local:setup preenche apenas credenciais do Supabase local.
APP_ENV=local
ENABLE_TURNSTILE=false
ENABLE_EMAIL=true
EMAIL_PROVIDER=smtp
APP_NAME=Herbamed Carreiras
APP_URL=http://localhost:3000
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# URL/chave publicáveis para upload direto do navegador. Em Docker, URL pública é localhost;
# URL de servidor acima é host.docker.internal.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor: RPC de código de Conta, troca de senha e fluxo legado de documentos.
SUPABASE_SERVICE_ROLE_KEY=
# Somente worker legado: conexão PostgreSQL privada. Não é necessária na Vercel.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# OAuth de login configurado no Supabase; não expor seus segredos ao browser.
# O envio Graph usa MS_GRAPH_* separadas, somente no servidor.
AZURE_CLIENT_ID=
AZURE_SECRET=
AZURE_TENANT_URL=https://login.microsoftonline.com/SEU-TENANT-ID
# Antibot obrigatório em ambientes cloud; segredo apenas servidor.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SIGNED_URL_TTL_SECONDS=60
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Herbamed Carreiras <carreiras@example.test>
# Envio Microsoft Graph (servidor). Use um arquivo privado separado para testar;
# não substitua o Mailpit nem as credenciais do banco local por valores hospedados.
# MS_GRAPH_TENANT_ID=
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# MS_GRAPH_SENDER=carreiras@example.test
# SUPABASE_SEND_EMAIL_HOOK_SECRET=v1,whsec_SUBSTITUA
