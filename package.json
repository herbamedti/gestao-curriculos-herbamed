{
  "name": "herbamed-carreiras",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/validate-deploy-env.mjs && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "node scripts/smoke-curriculum.mjs",
    "test:e2e:account": "node scripts/smoke-account.mjs",
    "test:e2e:email": "node scripts/smoke-email.mjs",
    "test:e2e:registration": "node scripts/smoke-registration-admin.mjs",
    "test:e2e:google": "node scripts/smoke-google-login.mjs",
    "email:test": "node --conditions=react-server --env-file=.env.graph.local --import tsx scripts/test-graph-email.ts",
    "test:e2e:legacy": "node scripts/smoke-local.mjs",
    "test:db": "supabase test db",
    "db:start": "node scripts/start-supabase.mjs",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:migrate": "supabase migration up --local",
    "db:types": "node scripts/database-types.mjs",
    "local:setup": "node scripts/local-setup.mjs",
    "local:start": "node scripts/start-local.mjs",
    "worker": "tsx scripts/worker.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "material-symbols": "^0.47.5",
    "next": "^16.3.6",
    "nodemailer": "^10.0.10",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "standardwebhooks": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "prettier": "^3.9.9",
    "supabase": "^2.120.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
