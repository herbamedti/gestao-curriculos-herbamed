# Modelo de referência. Cadastre cada valor em Vercel > Project Settings > Environment Variables.
# Não envie um .env preenchido ao Git nem copie as chaves locais deste computador.
APP_ENV=demo
APP_NAME=Herbamed Carreiras
APP_URL=https://SEU-PROJETO.vercel.app
SUPABASE_URL=https://SEU-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_SUBSTITUA
SUPABASE_SERVICE_ROLE_KEY=sb_secret_SUBSTITUA
ENABLE_TURNSTILE=false
ENABLE_EMAIL=false
# Para reativar, mude as flags para true e configure os serviços antes do redeploy:
# TURNSTILE_SITE_KEY=SUBSTITUA
# TURNSTILE_SECRET_KEY=SUBSTITUA
# SMTP_HOST=SUBSTITUA
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=SUBSTITUA
# SMTP_PASSWORD=SUBSTITUA
# SMTP_FROM=Herbamed Carreiras <no-reply@SEU-DOMINIO>
ENABLE_LEGACY_STORAGE_UPLOADS=false
